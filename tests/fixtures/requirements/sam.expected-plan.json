            "content": "[project]\nname = \"comfyui-meta-sam-audio\"\nversion = \"0.4.0\"\ndescription = \"Native ComfyUI nodes for local Meta SAM-Audio sound separation\"\nreadme = \"README.md\"\nrequires-python = \">=3.11\"\nlicense = { file = \"LICENSE\" }\nauthors = [{ name = \"ComfyUI SAM-Audio contributors\" }]\ndependencies = [\n    \"einops\",\n    \"ftfy\",\n    \"huggingface-hub\",\n    \"regex\",\n    \"safetensors\",\n    \"timm\",\n    \"torchdiffeq\",\n    \"tqdm\",\n    \"transformers>=4.54.0\",\n]\n\n[project.urls]\nRepository = \"https://github.com/ethanfel/ComfyUI-SAM-Audio\"\nIssues = \"https://github.com/ethanfel/ComfyUI-SAM-Audio/issues\"\nUpstream = \"https://github.com/facebookresearch/sam-audio\"\n\n[project.optional-dependencies]\ntest = [\"pytest>=8\", \"ruff\"]\n\n[tool.comfy]\nPublisherId = \"ethanfel\"\nDisplayName = \"Meta SAM-Audio\"\nIcon = \"\"\n\n[tool.pytest.ini_options]\ntestpaths = [\"tests\"]\n\n[tool.ruff]\ntarget-version = \"py311\"\nlint.select = [\"B\", \"E\", \"F\", \"I\", \"W\"]\nlint.ignore = [\"E501\"]\n",
